{
  "name": "coolfix",
  "version": "0.1.0",
  "private": true,
  "description": "CoolFix — Multi-Agent Technician Scheduling System (Show Me Your Agents Hackathon, NUS ISS)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/demoSeed.ts",
    "seed:hospital": "tsx scripts/demoSeed.ts --hospital",
    "hospital:unit": "tsx scripts/hospitalSeedUnit.ts",
    "demo:unit": "tsx scripts/demoSeedUnit.ts",
    "repo:unit": "tsx scripts/repoUnit.ts",
    "approval:unit": "tsx scripts/approvalUnit.ts",
    "flow:unit": "tsx scripts/flowMapUnit.ts",
    "time:unit": "tsx scripts/timeUnit.ts",
    "clock:real": "tsx scripts/useRealTime.ts",
    "flow:browser": "node scripts/flowMapBrowser.mjs",
    "routing:unit": "tsx scripts/routingUnit.ts && tsx scripts/routingUnit.ts --demo",
    "smoke": "tsx scripts/smoke.ts",
    "eval": "tsx scripts/eval.ts",
    "fuzz": "tsx scripts/fuzz.ts",
    "robustness": "tsx scripts/robustness.ts",
    "concurrency": "tsx scripts/concurrency.ts",
    "tracking:unit": "tsx scripts/trackingUnit.ts",
    "tracking:smoke": "tsx scripts/trackingSmoke.ts",
    "feedback:unit": "tsx scripts/feedbackUnit.ts",
    "feedback:smoke": "tsx scripts/feedbackSmoke.ts",
    "adaptive:unit": "tsx scripts/adaptivePolicyUnit.ts",
    "adaptive:smoke": "tsx scripts/adaptivePolicySmoke.ts",
    "assignment:unit": "tsx scripts/assignmentUnit.ts",
    "disruption:smoke": "tsx scripts/technicianUnavailableSmoke.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "dotenv": "16.4.5",
    "tsx": "4.16.2",
    "typescript": "5.5.3"
  }
}
