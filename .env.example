# ── CoolFix environment ─────────────────────────────────────────────
# Copy to .env.local and fill in for real LLM calls.
# If LLM_MODE=stub (default), no credentials are needed — agents use
# deterministic fixture responses from src/agents/fixtures.ts.

# stub | gateway | openai
LLM_MODE=stub

# ── Competition LLM gateway (LLM_MODE=gateway) ─────────────────────
# The hackathon provider: the organisers' self-hosted AWS LLM gateway.
# Ollama-compatible /api/chat, X-API-Key auth, Claude Sonnet 4.5 on AWS
# behind it. Same prompt frame + JSON contract as every other mode.
LLM_GATEWAY_URL=https://api.softwaresystems.app
LLM_GATEWAY_API_KEY=
LLM_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# ── OpenAI (LLM_MODE=openai) — dev fallback only ──────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: override for Azure OpenAI / a proxy. Default: https://api.openai.com/v1
OPENAI_BASE_URL=

# Optional: cap total LLM calls per process to protect API credit
LLM_CALL_BUDGET=200

# ── Supabase ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Technician routing (optional overrides) ────────────────────────
# Public OSRM and data.gov.sg endpoints work for the demo without keys.
OSRM_BASE_URL=https://router.project-osrm.org
DATA_GOV_TRAFFIC_IMAGES_URL=https://api.data.gov.sg/v1/transport/traffic-images
DATA_GOV_SG_API_KEY=    
