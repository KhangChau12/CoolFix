# ── CoolFix environment ─────────────────────────────────────────────
# Copy to .env.local and fill in for real Bedrock calls.
# If LLM_MODE=stub (default), no AWS credentials are needed — agents
# use deterministic fixture responses from src/agents/fixtures/.

# stub | bedrock
LLM_MODE=stub

# AWS Bedrock (only needed when LLM_MODE=bedrock)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Model id per hackathon rules: Claude Sonnet 4.5 on Bedrock
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-5-20250929-v1:0

# Optional: cap total LLM calls per process to protect AWS credit
LLM_CALL_BUDGET=200
