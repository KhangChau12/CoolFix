# ── CoolFix environment ─────────────────────────────────────────────
# Copy to .env.local and fill in for real LLM calls.
# If LLM_MODE=stub (default), no credentials are needed — agents use
# deterministic fixture responses from src/agents/fixtures.ts.

# stub | bedrock | openai
LLM_MODE=stub

# ── AWS Bedrock (only when LLM_MODE=bedrock) ────────────────────────
# Hackathon default provider. Model id: Claude Sonnet 4.5 on Bedrock.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-5-20250929-v1:0

# ── OpenAI (only when LLM_MODE=openai) ──────────────────────────────
# Same prompt frame + JSON contract as Bedrock — no agent code changes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: override for Azure OpenAI / a proxy. Default: https://api.openai.com/v1
OPENAI_BASE_URL=

# Optional: cap total LLM calls per process to protect API credit
LLM_CALL_BUDGET=200

# ── Supabase ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
